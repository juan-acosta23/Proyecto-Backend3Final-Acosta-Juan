<link rel="stylesheet" href="/css/views/register.css">

<div class="auth-container">
    <h1>Crear Cuenta</h1>
    
    <form id="registerForm">
        <div class="form-row-2">
            <div>
                <label>Nombre:</label>
                <input type="text" id="first_name" name="first_name" required minlength="2" placeholder="Juan">
            </div>
            <div>
                <label>Apellido:</label>
                <input type="text" id="last_name" name="last_name" required minlength="2" placeholder="Pérez">
            </div>
        </div>
        
        <div class="form-group">
            <label>Email:</label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com">
        </div>
        
        <div class="form-row-2-1">
            <div>
                <label>Contraseña:</label>
                <input type="password" id="password" name="password" required minlength="6" placeholder="Mínimo 6 caracteres">
            </div>
            <div>
                <label>Edad:</label>
                <input type="number" id="age" name="age" required min="18" max="120" placeholder="18+">
            </div>
        </div>
        
        <button type="submit" class="btn-submit">Crear Cuenta</button>
    </form>
    
    <div id="message" class="message-box"></div>
    
    <div class="auth-footer">
        <p>¿Ya tienes una cuenta?</p>
        <a href="/login">Iniciar sesión aquí</a>
    </div>
</div>

<script>
    document.getElementById('registerForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = {
            first_name: document.getElementById('first_name').value,
            last_name: document.getElementById('last_name').value,
            email: document.getElementById('email').value,
            password: document.getElementById('password').value,
            age: parseInt(document.getElementById('age').value)
        };
        const messageDiv = document.getElementById('message');
        try {
            const response = await fetch('/api/sessions/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });
            const data = await response.json();
            if (data.status === 'success') {
                messageDiv.className = 'message-box success';
                messageDiv.style.display = 'block';
                messageDiv.textContent = data.message + ' - Redirigiendo...';
                localStorage.setItem('token', data.payload.token);
                setTimeout(() => { window.location.href = '/products'; }, 1500);
            } else {
                messageDiv.className = 'message-box error';
                messageDiv.style.display = 'block';
                messageDiv.textContent = data.message;
            }
        } catch (error) {
            messageDiv.className = 'message-box error';
            messageDiv.style.display = 'block';
            messageDiv.textContent = 'Error en la conexión';
            console.error('Error:', error);
        }
    });
</script>
