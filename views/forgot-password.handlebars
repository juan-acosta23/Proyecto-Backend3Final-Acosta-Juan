<link rel="stylesheet" href="/css/views/forgot-password.css">

<div class="auth-container">
    <h1>Recuperar Contraseña</h1>
    
    <p class="subtitle">
        Ingresa tu email y te enviaremos un enlace para restablecer tu contraseña.
    </p>
    
    <form id="forgotPasswordForm">
        <div class="form-group">
            <label>Email:</label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com">
        </div>
        
        <button type="submit" class="btn-submit">
            Enviar Enlace de Recuperación
        </button>
    </form>
    
    <div id="message" class="message-box"></div>
    
    <div class="auth-footer">
        <a href="/login">← Volver al login</a>
    </div>
</div>

<script>
    document.getElementById('forgotPasswordForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value;
        const messageDiv = document.getElementById('message');
        const submitButton = e.target.querySelector('button[type="submit"]');
        submitButton.disabled = true;
        submitButton.textContent = 'Enviando...';
        try {
            const response = await fetch('/api/sessions/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });
            const data = await response.json();
            messageDiv.className = 'message-box success';
            messageDiv.style.display = 'block';
            messageDiv.textContent = data.message;
            document.getElementById('forgotPasswordForm').reset();
        } catch (error) {
            messageDiv.className = 'message-box error';
            messageDiv.style.display = 'block';
            messageDiv.textContent = 'Error en la conexión';
            console.error('Error:', error);
        } finally {
            submitButton.disabled = false;
            submitButton.textContent = 'Enviar Enlace de Recuperación';
        }
    });
</script>
